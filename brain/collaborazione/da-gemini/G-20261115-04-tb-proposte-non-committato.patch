     e = dict(voce, ipotesi=ipotesi, ora=ora)
+    if ruolo in ("sviluppo", "esito") and ("verdetto" in voce or "promossa" in voce):
+        v = verdetto_esecuzione(e)
+        e["verdetto"] = v
+        e["promossa"] = (v == "promossa")
     dati["esecuzioni"].append(e)
     _scrivi(registro, dati)
     return e
