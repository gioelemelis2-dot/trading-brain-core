         return _registra(registro, ipotesi, voce, ora)
 
 
+def verdetto_esecuzione(e: dict) -> str:
+    """Legge lo stato a tre valori (`promossa`, `non decidibile`, `bocciata`) da una voce del registro."""
+    v = e.get("verdetto")
+    if v in VERDETTI:
+        if "promossa" in e and e["promossa"] is not None and bool(e["promossa"]) != (v == "promossa"):
+            raise ValueError(f"esito incoerente nel registro: verdetto={v!r}, promossa={e['promossa']!r}")
+        return v
+    if v is not None:
+        raise ValueError(f"verdetto {v!r} non in {VERDETTI}")
+    return "promossa" if bool(e.get("promossa")) else "bocciata"
+
+
+def stato_sviluppo(esiti: Sequence[dict]) -> Optional[str]:
+    """Stato cumulativo delle esecuzioni di sviluppo di una variante:
+    - nessuna esecuzione: None;
+    - qualsiasi `bocciata`: 'bocciata' (terminale, resta bloccante);
+    - altrimenti l'ultimo verdetto ('promossa' o 'non decidibile': una parcheggiata può tornare ammissibile)."""
+    if not esiti:
+        return None
+    stati = [verdetto_esecuzione(e) for e in esiti]
+    if "bocciata" in stati:
+        return "bocciata"
+    return stati[-1]
+
+
 def _registra(registro: Path, ipotesi: str, voce: dict, ora: str) -> dict:
     dati = leggi(registro)
     if _sigillo(dati, ipotesi) is None:
@@ -138,6 +164,10 @@ def _registra(registro: Path, ipotesi: str, voce: dict, ora: str) -> dict:
