+
+class TestEventDrivenBacktesterZeroTrust(unittest.TestCase):
+    def setUp(self):
+        self.temp_dir = Path(tempfile.mkdtemp(prefix="test_bt_zt_"))
+        self.t0 = datetime(2026, 1, 1, 0, 0, tzinfo=timezone.utc)
