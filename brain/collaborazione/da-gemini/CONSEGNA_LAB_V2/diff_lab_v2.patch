+"""
+Pipeline di ingestione e validazione per dati storici OHLCV.
+Verifica:
+1. Formato temporale UTC nativo con offset esplicito (vietato mascheramento di timezone tramite replace).
+2. Distinzione rigorosa tra open_time e close_time (anti look-ahead bias).
+3. Monotonia stretta della sequenza cronologica.
+4. Assenza di sovrapposizioni temporali (overlap) o inversioni.
+5. Controllo buchi anomali non dichiarati.
+6. Blocco dati futuri rispetto al timestamp di cutoff della ricerca.
+"""
+
+import csv
+import json
+from datetime import datetime, timezone, timedelta
+from decimal import Decimal
+from typing import List, Optional, Union, Dict, Any
+from pathlib import Path
+
+from .models import (
+    Candle,
+    DataValidationError,
+    MonotonicityError,
+    LookAheadDataError,
+    AnomalyGapError,
+    EpistemicType,
+    parse_iso_utc,
+)
+
+
+class DataIngestionPipeline:
+    def __init__(
+        self,
+        symbol: str,
+        timeframe: str,
+        max_allowed_utc: Optional[datetime] = None,
+        max_gap_seconds: Optional[int] = None,
+    ):
+        self.symbol = symbol
+        self.timeframe = timeframe
+        if max_allowed_utc is not None:
+            if max_allowed_utc.tzinfo is None or max_allowed_utc.utcoffset() != timedelta(0):
+                raise DataValidationError("max_allowed_utc deve avere timezone UTC esplicito.")
+        self.max_allowed_utc = max_allowed_utc
+        self.max_gap_seconds = max_gap_seconds
+
+    def parse_csv_stream(self, file_path: Union[str, Path]) -> List[Candle]:
+        candles: List[Candle] = []
+        path = Path(file_path)
+        if not path.exists():
+            raise FileNotFoundError(f"File dati non trovato: {path}")
+
+        with open(path, mode="r", encoding="utf-8") as f:
+            reader = csv.DictReader(f)
+            for row_idx, row in enumerate(reader, start=1):
+                try:
+                    open_time = self._parse_iso_utc(row["open_time"])
+                    if "close_time" in row and row["close_time"]:
+                        close_time = self._parse_iso_utc(row["close_time"])
+                    else:
+                        close_time = open_time + self._timeframe_to_timedelta(self.timeframe)
+
+                    candle = Candle(
+                        symbol=self.symbol,
+                        timeframe=self.timeframe,
+                        open_time=open_time,
+                        close_time=close_time,
+                        open=Decimal(str(row["open"])),
+                        high=Decimal(str(row["high"])),
+                        low=Decimal(str(row["low"])),
+                        close=Decimal(str(row["close"])),
+                        volume=Decimal(str(row["volume"])),
+                    )
+                    candles.append(candle)
+                except Exception as e:
+                    raise DataValidationError(f"Errore riga {row_idx} in {path.name}: {e}") from e
+
+        return self.validate_sequence(candles)
+
+    def parse_jsonl(self, file_path: Union[str, Path]) -> List[Candle]:
+        candles: List[Candle] = []
+        path = Path(file_path)
+        if not path.exists():
+            raise FileNotFoundError(f"File dati non trovato: {path}")
+
+        with open(path, mode="r", encoding="utf-8") as f:
+            for line_idx, line in enumerate(f, start=1):
+                line = line.strip()
+                if not line:
+                    continue
+                try:
+                    data = json.loads(line)
+                    candles.append(Candle.from_dict(data))
+                except Exception as e:
+                    raise DataValidationError(f"Errore JSON riga {line_idx} in {path.name}: {e}") from e
+
+        return self.validate_sequence(candles)
+
+    def validate_sequence(self, candles: List[Candle]) -> List[Candle]:
+        if not candles:
+            return []
+
+        prev_candle: Optional[Candle] = None
+
+        for idx, candle in enumerate(candles):
+            # 1. Verifica cutoff dati futuri (Anti-Lookahead)
+            if self.max_allowed_utc and candle.close_time > self.max_allowed_utc:
+                raise LookAheadDataError(
+                    f"Violazione temporale alla candela {idx} ({candle.symbol}): "
+                    f"close_time ({candle.close_time.isoformat()}) supera il cutoff autorizzato ({self.max_allowed_utc.isoformat()})."
+                )
+
+            # 2. Verifica sequenzialita' e monotonia
+            if prev_candle is not None:
+                if candle.open_time < prev_candle.close_time:
+                    raise MonotonicityError(
+                        f"Inversione/Sovrapposizione cronologica alla candela {idx}: "
+                        f"open_time attuale ({candle.open_time.isoformat()}) < close_time precedente ({prev_candle.close_time.isoformat()})."
+                    )
+
+                if candle.open_time < prev_candle.open_time:
+                    raise MonotonicityError(
+                        f"Inversione temporale alla candela {idx}: "
+                        f"open_time ({candle.open_time.isoformat()}) < open_time precedente ({prev_candle.open_time.isoformat()})."
+                    )
+
+                # 3. Controllo buchi temporali non dichiarati
+                if self.max_gap_seconds is not None:
+                    gap_seconds = (candle.open_time - prev_candle.close_time).total_seconds()
+                    if gap_seconds > self.max_gap_seconds:
+                        raise AnomalyGapError(
+                            f"Buco temporale anomalo alla candela {idx}: "
+                            f"distacco di {gap_seconds} secondi (massimo consentito: {self.max_gap_seconds}s) "
+                            f"tra {prev_candle.close_time.isoformat()} e {candle.open_time.isoformat()}."
+                        )
+
+            prev_candle = candle
+
+        return candles
+
+    @staticmethod
+    def _parse_iso_utc(val: str) -> datetime:
+        return parse_iso_utc(val)
+
+    @staticmethod
+    def _timeframe_to_timedelta(tf: str) -> timedelta:
+        tf = tf.upper()
+        if tf == "1M":
+            return timedelta(minutes=1)
+        if tf == "5M":
+            return timedelta(minutes=5)
+        if tf == "15M":
+            return timedelta(minutes=15)
+        if tf == "1H":
+            return timedelta(hours=1)
+        if tf == "4H":
+            return timedelta(hours=4)
+        if tf == "1D":
+            return timedelta(days=1)
+        raise ValueError(f"Timeframe non supportato per calcolo automatico: {tf}")
diff --git a/brain/dati/pipeline/models.py b/brain/dati/pipeline/models.py
new file mode 100644
index 0000000..3b64e9a
--- /dev/null
+++ b/brain/dati/pipeline/models.py
@@ -0,0 +1,188 @@
+"""
+Modello dati epistemico per candele storiche OHLCV.
+Governance Epistemica: Ogni candela e' una MISURA aggregata priva di interpretazione.
+Tutti i valori monetari e di prezzo utilizzano esclusivamente Decimal per prevenire errori di floating point.
+Tutti i timestamp richiedono obbligatoriamente un fuso orario UTC esplicito (divieto assoluto di mascheramento di timezone tramite replace).
+"""
+
+from dataclasses import dataclass, field
+from datetime import datetime, timezone, timedelta
+from decimal import Decimal, InvalidOperation
+from enum import Enum
+import re
+from typing import Any, Dict
+
+from brain.guardian.g0.valori import Valore, misura
+
+
+def parse_iso_utc(val: str) -> datetime:
+    """
+    Analizza un timestamp ISO-8601 con fuso orario esplicito (inclusi 'Z' e frazioni di secondo variabili)
+    mantenendo compatibilita' con Python 3.9+ e rifiutando timestamp privi di fuso orario.
+    """
+    if not isinstance(val, str) or not val.strip():
+        raise DataValidationError(f"Timestamp ISO-8601 non valido: {val!r}")
+    s = val.strip()
+    if s.endswith("Z"):
+        s = s[:-1] + "+00:00"
+    m = re.search(r"\.(\d+)", s)
+    if m:
+        frac = m.group(1)
+        norm_frac = (frac + "000000")[:6]
+        s = s[:m.start(1)] + norm_frac + s[m.end(1):]
+    try:
+        dt = datetime.fromisoformat(s)
+    except ValueError as e:
+        raise DataValidationError(f"Formato ISO-8601 non valido '{val}': {e}") from e
+    if dt.tzinfo is None:
+        raise DataValidationError(
+            f"Timestamp privo di fuso orario UTC esplicito: '{val}'. Richiesto suffisso UTC (+00:00 o Z)."
+        )
+    if dt.utcoffset() != timedelta(0):
+        dt = dt.astimezone(timezone.utc)
+    return dt
+
+
+class EpistemicType(str, Enum):
+    MISURA = "MISURA"
+    DERIVATO = "DERIVATO"
+    STIMA = "STIMA"
+    IPOTESI = "IPOTESI"
+    REGOLA = "REGOLA"
+
+
+class DataValidationError(ValueError):
+    """Sollevata quando una candela viola vincoli fisici o temporali."""
+    pass
+
+
+class MonotonicityError(DataValidationError):
+    """Sollevata quando la sequenza temporale delle candele non e' strettamente crescente."""
+    pass
+
+
+class LookAheadDataError(DataValidationError):
+    """Sollevata quando una candela include dati futuri rispetto al cutoff consentito."""
+    pass
+
+
+class AnomalyGapError(DataValidationError):
+    """Sollevata quando si riscontra un buco anomalo non giustificato nel feed."""
+    pass
+
+
+@dataclass(frozen=True)
+class Candle:
+    symbol: str
+    timeframe: str
+    open_time: datetime
+    close_time: datetime
+    open: Decimal
+    high: Decimal
+    low: Decimal
+    close: Decimal
+    volume: Decimal
+    epistemic_type: EpistemicType = field(default=EpistemicType.MISURA)
+    condition_h: str = field(default="{H_feed_integro}")
+
+    def __post_init__(self):
+        # 1. Validazione Tipi e Timestamp UTC Esplicito
+        if not isinstance(self.open_time, datetime) or not isinstance(self.close_time, datetime):
+            raise DataValidationError("open_time e close_time devono essere oggetti datetime.")
+        
+        if self.open_time.tzinfo is None or self.open_time.utcoffset() != timedelta(0):
+            raise DataValidationError(
+                f"open_time deve avere timezone UTC esplicito (+00:00 o Z). Trovato: {self.open_time.tzinfo}"
+            )
+        if self.close_time.tzinfo is None or self.close_time.utcoffset() != timedelta(0):
+            raise DataValidationError(
+                f"close_time deve avere timezone UTC esplicito (+00:00 o Z). Trovato: {self.close_time.tzinfo}"
+            )
+
+        if self.open_time >= self.close_time:
+            raise DataValidationError(
+                f"open_time ({self.open_time.isoformat()}) deve essere strettamente precedente a close_time ({self.close_time.isoformat()})."
+            )
+
+        # 2. Controllo Divieto Float e Conversione Rigorosa Decimal
+        for field_name in ["open", "high", "low", "close", "volume"]:
+            val = getattr(self, field_name)
+            if isinstance(val, float):
+                raise TypeError(
+                    f"Violazione Governance Epistemica: Il campo '{field_name}' e' di tipo float ({val}). "
+                    f"E' tassativo l'uso esclusivo di Decimal per evitare approssimazioni binarie."
+                )
+            if not isinstance(val, Decimal):
+                try:
+                    val = Decimal(str(val))
+                    object.__setattr__(self, field_name, val)
+                except (InvalidOperation, TypeError):
+                    raise DataValidationError(f"Impossibile convertire '{field_name}' in Decimal: {val}")
+            if not val.is_finite():
+                raise DataValidationError(
+                    f"Il campo '{field_name}' deve essere un Decimal finito (NaN o Infinity vietati): {val}"
+                )
+
+        # 3. Validazione Coerenza Prezzi
+        if self.low > self.high:
+            raise DataValidationError(f"Incoerenza prezzi: Low ({self.low}) > High ({self.high}).")
+        if self.open > self.high or self.open < self.low:
+            raise DataValidationError(f"Incoerenza prezzi: Open ({self.open}) fuori dal range [{self.low}, {self.high}].")
+        if self.close > self.high or self.close < self.low:
+            raise DataValidationError(f"Incoerenza prezzi: Close ({self.close}) fuori dal range [{self.low}, {self.high}].")
+        if self.volume < Decimal("0"):
+            raise DataValidationError(f"Volume negativo non consentito: {self.volume}")
+
+    @property
+    def open_valore(self) -> Valore:
+        return misura(self.open, unita="price", fonte=f"feed:{self.symbol}:{self.timeframe}")
+
+    @property
+    def high_valore(self) -> Valore:
+        return misura(self.high, unita="price", fonte=f"feed:{self.symbol}:{self.timeframe}")
+
+    @property
+    def low_valore(self) -> Valore:
+        return misura(self.low, unita="price", fonte=f"feed:{self.symbol}:{self.timeframe}")
+
+    @property
+    def close_valore(self) -> Valore:
+        return misura(self.close, unita="price", fonte=f"feed:{self.symbol}:{self.timeframe}")
+
+    @property
+    def volume_valore(self) -> Valore:
+        return misura(self.volume, unita="volume", fonte=f"feed:{self.symbol}:{self.timeframe}")
+
+    def to_dict(self) -> Dict[str, Any]:
+        return {
+            "symbol": self.symbol,
+            "timeframe": self.timeframe,
+            "open_time": self.open_time.isoformat(),
+            "close_time": self.close_time.isoformat(),
+            "open": str(self.open),
+            "high": str(self.high),
+            "low": str(self.low),
+            "close": str(self.close),
+            "volume": str(self.volume),
+            "epistemic_type": self.epistemic_type.value,
+            "condition_h": self.condition_h,
+        }
+
+    @classmethod
+    def from_dict(cls, data: Dict[str, Any]) -> "Candle":
+        open_time = parse_iso_utc(data["open_time"])
+        close_time = parse_iso_utc(data["close_time"])
+
+        return cls(
+            symbol=data["symbol"],
+            timeframe=data["timeframe"],
+            open_time=open_time,
+            close_time=close_time,
+            open=Decimal(str(data["open"])),
+            high=Decimal(str(data["high"])),
+            low=Decimal(str(data["low"])),
+            close=Decimal(str(data["close"])),
+            volume=Decimal(str(data["volume"])),
+            epistemic_type=EpistemicType(data.get("epistemic_type", "MISURA")),
+            condition_h=data.get("condition_h", "{H_feed_integro}"),
+        )
diff --git a/brain/dati/pipeline/partitioning.py b/brain/dati/pipeline/partitioning.py
new file mode 100644
index 0000000..c59c32c
--- /dev/null
+++ b/brain/dati/pipeline/partitioning.py
@@ -0,0 +1,191 @@
+"""
+Partizionamento rigoroso In-Sample / Out-Of-Sample e Sigillo Crittografico OOS.
+Nota di Sicurezza: Questo modulo implementa un *commitment* crittografico basato su hash
+(hiding & binding tramite nonce segreto CSPRNG a 256-bit), NON una firma digitale asimmetrica.
+Chi custodisce il nonce puo' ricalcolare o rigenerare il commitment: per garantire la
+separazione dei ruoli, il nonce puo' essere isolato in un percorso dedicato tramite `nonce_dir`
+o la variabile d'ambiente `TRADING_OOS_NONCE_DIR`.
+Allineato formalmente allo standard di brain/guardian/journal/journal.py (sigilla):
+Impegno = SHA256((nonce_hex + oos_text_canonico).encode("utf-8"))
+Verifica tramite secrets.compare_digest.
+"""
+
+import hashlib
+import json
+import os
+import secrets
+from datetime import datetime, timezone, timedelta
+from pathlib import Path
+from typing import List, Tuple, Dict, Any, Optional
+
+from .models import Candle, DataValidationError
+
+
+def _canonico(obj) -> str:
+    return json.dumps(obj, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
+
+
+class DatasetPartitioner:
+    def __init__(self, in_sample_ratio: float = 0.7):
+        if not (0.1 <= in_sample_ratio <= 0.9):
+            raise ValueError(f"in_sample_ratio deve essere compreso tra 0.1 e 0.9. Trovato: {in_sample_ratio}")
+        self.in_sample_ratio = in_sample_ratio
+
+    def split(
+        self,
+        candles: List[Candle],
+        output_dir: Path,
+        split_time: Optional[datetime] = None,
+        nonce_dir: Optional[Path] = None,
+    ) -> Tuple[Path, Path, Path]:
+        """
+        Separa fisicamente le candele in IN-SAMPLE e OUT-OF-SAMPLE.
+        Genera commitment.json sigillando l'OOS con Nonce CSPRNG a 256 bit (commitment crittografico).
+        Il nonce viene salvato in `nonce_dir`, oppure in `TRADING_OOS_NONCE_DIR` se impostata,
+        altrimenti in `output_dir`.
+        """
+        if not candles:
+            raise ValueError("Impossibile partizionare un dataset vuoto.")
+
+        output_dir = Path(output_dir)
+        output_dir.mkdir(parents=True, exist_ok=True)
+
+        if split_time is not None:
+            if split_time.tzinfo is None or split_time.utcoffset() != timedelta(0):
+                raise DataValidationError("split_time deve avere timezone UTC esplicito.")
+            in_sample = [c for c in candles if c.close_time <= split_time]
+            out_of_sample = [c for c in candles if c.close_time > split_time]
+            assert len(in_sample) + len(out_of_sample) == len(candles), (
+                "Partizione non disgiunta/esaustiva su split_time."
+            )
+            if not in_sample or not out_of_sample:
+                raise ValueError(
+                    "Partizione non valida su split_time: in_sample e out_of_sample devono essere entrambi non vuoti."
+                )
+        else:
+            split_idx = int(len(candles) * self.in_sample_ratio)
+            if split_idx <= 0 or split_idx >= len(candles):
+                raise ValueError("Dimensione insufficiente per partizionare In-Sample e Out-Of-Sample.")
+            in_sample = candles[:split_idx]
+            out_of_sample = candles[split_idx:]
+
+        # 1. Scrittura In-Sample JSONL
+        is_path = output_dir / "in_sample.jsonl"
+        with open(is_path, "w", encoding="utf-8") as f:
+            for c in in_sample:
+                f.write(_canonico(c.to_dict()) + "\n")
+
+        # 2. Scrittura Out-Of-Sample JSONL Canonico
+        oos_path = output_dir / "out_of_sample.jsonl"
+        oos_canonical_lines = []
+        with open(oos_path, "w", encoding="utf-8") as f:
+            for c in out_of_sample:
+                line = _canonico(c.to_dict())
+                f.write(line + "\n")
+                oos_canonical_lines.append(line)
+
+        oos_text_canonico = "\n".join(oos_canonical_lines) + "\n"
+
+        # 3. Generazione Nonce Casuale a 256-bit (32 byte hex) CSPRNG
+        nonce_hex = secrets.token_hex(32)
+
+        # 4. Calcolo Sigillo Crittografico SHA-256 standard Journal
+        # Formula journal.sigilla: SHA256((nonce_hex + payload_text).encode("utf-8"))
+        hasher = hashlib.sha256()
+        hasher.update((nonce_hex + oos_text_canonico).encode("utf-8"))
+        commitment_hash = hasher.hexdigest()
+
+        oos_sha256 = hashlib.sha256(oos_text_canonico.encode("utf-8")).hexdigest()
+
+        # 5. Scrittura commitment.json
+        commitment_data = {
+            "protocol": "SEALED_OOS_RESEARCH_COMMITMENT_V2",
+            "epistemic_type": "REGOLA",
+            "condition_h": "{H_oos_sigillato}",
+            "created_at_utc": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
+            "symbol": candles[0].symbol,
+            "timeframe": candles[0].timeframe,
+            "total_records": len(candles),
+            "in_sample_count": len(in_sample),
+            "out_of_sample_count": len(out_of_sample),
+            "split_boundary_utc": in_sample[-1].close_time.isoformat(),
+            "oos_sha256": oos_sha256,
+            "commitment_hash": commitment_hash,
+            "status": "SEALED_LOCKED",
+        }
+
+        commitment_path = output_dir / "commitment.json"
+        with open(commitment_path, "w", encoding="utf-8") as f:
+            f.write(json.dumps(commitment_data, indent=2) + "\n")
+
+        # 6. Scrittura file nonce in percorso isolabile (parametro -> env -> output_dir)
+        env_nonce_dir = os.environ.get("TRADING_OOS_NONCE_DIR")
+        if nonce_dir is not None:
+            resolved_nonce_dir = Path(nonce_dir)
+        elif env_nonce_dir:
+            resolved_nonce_dir = Path(env_nonce_dir)
+        else:
+            resolved_nonce_dir = output_dir
+        resolved_nonce_dir.mkdir(parents=True, exist_ok=True)
+        nonce_path = resolved_nonce_dir / "sealed_nonce.secret"
+        with open(nonce_path, "w", encoding="utf-8") as f:
+            f.write(nonce_hex + "\n")
+
+        return is_path, oos_path, commitment_path
+
+    @staticmethod
+    def verify_commitment(oos_file: Path, commitment_file: Path, nonce_file: Path) -> Dict[str, Any]:
+        """
+        Verifica crittografica formale dell'integrita' del dataset Out-Of-Sample.
+        Usa secrets.compare_digest per prevenire attacchi di temporizzazione.
+        Gestisce gracefully commitment.json malformati restituendo valid=False e reason.
+        """
+        oos_file = Path(oos_file)
+        commitment_file = Path(commitment_file)
+        nonce_file = Path(nonce_file)
+
+        try:
+            with open(commitment_file, "r", encoding="utf-8") as f:
+                comm = json.load(f)
+        except (OSError, json.JSONDecodeError, ValueError):
+            return {
+                "valid": False,
+                "oos_match": False,
+                "commitment_match": False,
+                "reason": "commitment malformato",
+            }
+
+        if (
+            not isinstance(comm, dict)
+            or not isinstance(comm.get("oos_sha256"), str)
+            or not isinstance(comm.get("commitment_hash"), str)
+        ):
+            return {
+                "valid": False,
+                "oos_match": False,
+                "commitment_match": False,
+                "reason": "commitment malformato",
+            }
+
+        with open(nonce_file, "r", encoding="utf-8") as f:
+            nonce_hex = f.read().strip()
+
+        with open(oos_file, "r", encoding="utf-8") as f:
+            oos_text = f.read()
+
+        computed_oos_sha = hashlib.sha256(oos_text.encode("utf-8")).hexdigest()
+
+        hasher = hashlib.sha256()
+        hasher.update((nonce_hex + oos_text).encode("utf-8"))
+        computed_commitment = hasher.hexdigest()
+
+        is_oos_valid = secrets.compare_digest(computed_oos_sha, comm["oos_sha256"])
+        is_commitment_valid = secrets.compare_digest(computed_commitment, comm["commitment_hash"])
+
+        return {
+            "valid": is_oos_valid and is_commitment_valid,
+            "oos_match": is_oos_valid,
+            "commitment_match": is_commitment_valid,
+            "expected_commitment": comm["commitment_hash"],
+            "computed_commitment": computed_commitment,
+        }
