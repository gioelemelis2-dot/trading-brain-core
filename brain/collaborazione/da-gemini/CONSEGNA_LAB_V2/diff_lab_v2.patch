+# 5. CODICE SORGENTE DEGLI SCRIPT E NUOVI TEST DI VERIFICA
+
+### 5.1 Implementazione delle 3 Nuove Funzioni di Test (V22, V16, V24)
+Questi test sono pronti per essere inseriti in `test_prop_risk_v3_3.py` nella directory di staging dell'Errata:
+
+```python
+import math
+import pytest
+from prop_risk_engine_v3_3 import (
+    simulate_first_passage_bridge,
+    solve_drift_for_target_winrate,
+    assert_monotonic_bracketing
+)
+
+def test_mutant_v22_deterministic_analytical_gap():
+    """
+    T-01: Abbattimento deterministico del mutante V22.
+    Mutante V22: usa abs(mu) < 0.1 invece di abs(mu) < 1e-7.
+    Con a=1.0, b=2.0, u=0.5, mu=0.05:
+      m_mutant = (1.0 * 2.0 * 0.5) / (2.0 + 0.5) = 0.400000000000
+      m_true   = ln(y) / (2 * mu)               = 0.399520731657
+      Scarto analitico: Delta = 0.000479268343 (~4.79e-4) >> tol=1e-12.
+    """
+    a = 1.0
+    b = 2.0
+    u = 0.5
+    mu = 0.05
+
+    # Valore teorico esatto calcolato analiticamente
+    arg_b = -2.0 * mu * b
+    arg_a = 2.0 * mu * a
+    num_c1 = -math.expm1(arg_b)
+    den_c1 = math.expm1(arg_a)
+    c1 = num_c1 / den_c1
+    term1 = num_c1 * (1.0 + 1.0 / den_c1)
+    term2 = u * math.exp(arg_b)
+    y = (term1 + term2) / (u + c1)
+    m_expected = math.log(y) / (2.0 * mu)
+
+    # Chiamata al motore con seed e parametri fissati
+    m_engine = simulate_first_passage_bridge(a=a, b=b, u=u, mu=mu)
+
+    # Verifica: il motore corretto deve coincidere con la teoria a 1e-12
+    assert math.isclose(m_engine, m_expected, abs_tol=1e-12), (
+        f"Errore di calcolo motore: ottenuto {m_engine}, atteso {m_expected}"
+    )
+
+    # Verifica abbattimento mutante: m_engine non deve essere 0.400000
+    m_mutant = (a * b * (1.0 - u)) / (b + a * u)
+    delta = abs(m_engine - m_mutant)
+    assert delta > 1e-5, f"Mutante V22 sopravvissuto! Delta={delta}"
+
+
+def test_unreachable_target_v16_edge_case():
+    """
+    T-04: Verifica sollevamento ValueError per parametri matematicamente irraggiungibili.
+    Per WR=0.40 e RR=0.001 con a=1.0, b=0.001:
+      P_win(0)  ~ 0.999
+      P_win(-15)~ 0.9704
+    WR=0.40 e' matematicamente irraggiungibile in [-15, 15].
+    Il motore corretto DEVE sollevare ValueError. Il mutante V16 fallisce.
+    """
+    with pytest.raises(ValueError, match=r"unreachable|cannot bracket|monotonic"):
+        solve_drift_for_target_winrate(
+            target_wr=0.40,
+            rr=0.001,
+            a=1.0,
+            low_bound=-15.0,
+            high_bound=15.0,
+            tol=1e-6
+        )
+
+
+def test_negative_drift_closed_form_v24():
+    """
+    T-04: Verifica analitica indipendente a deriva negativa contro formula chiusa.
+    Mutante V24: altera il branch a deriva negativa.
+    Formula chiusa indipendente di P_win per deriva negativa:
+      P_win(mu) = (1 - exp(2*mu)) / (exp(-2*mu*RR) - exp(2*mu))
+    """
+    scenarios = [
+        {"mu": -0.5, "rr": 1.0},
+        {"mu": -2.0, "rr": 0.5},
+        {"mu": -1.0, "rr": 2.0}
+    ]
+
+    for sc in scenarios:
+        mu = sc["mu"]
+        rr = sc["rr"]
+        a = 1.0
+
+        # Formula chiusa indipendente calcolata localmente
+        exp_num = 1.0 - math.exp(2.0 * mu * a)
+        exp_den = math.exp(-2.0 * mu * rr) - math.exp(2.0 * mu * a)
+        p_win_theoretical = exp_num / exp_den
+
+        # Inversione con il motore
+        mu_solved = solve_drift_for_target_winrate(
+            target_wr=p_win_theoretical,
+            rr=rr,
+            a=a,
+            low_bound=-15.0,
+            high_bound=15.0,
+            tol=1e-9
+        )
+
+        assert math.isclose(mu_solved, mu, abs_tol=1e-6), (
+            f"Deriva negativa non coincidente: risolto {mu_solved}, teorico {mu}"
+        )
+```
